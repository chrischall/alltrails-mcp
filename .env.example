# All optional. There are no credentials to set: every request runs inside
# your signed-in alltrails.com tab through the fetchproxy browser bridge
# (ContextMint Bridge extension), so the browser supplies the session.
# See README "Configuration" for details.

# Numeric user id for the per-user tools (lists, completed trails, feed).
# Unset → resolved from the signed-in session via /api/alltrails/me.
# ALLTRAILS_USER_ID=

# Per-request timeout in ms (default 30000).
# ALLTRAILS_REQUEST_TIMEOUT_MS=

# 1/true/yes/on → log each request's method, path, status and response size
# to stderr (response bodies are never logged). Diagnostic only.
# ALLTRAILS_DEBUG_LOG=

# fetchproxy concentrator port (default 37149, shared by the whole fleet —
# override only for local development or test isolation).
# ALLTRAILS_WS_PORT=

# Override the x-language-locale / x-at-caller request headers.
# ALLTRAILS_LOCALE=
# ALLTRAILS_CALLER=
